# Rename this file to .env and fill in your own values

# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Any long random string - used to sign JWT tokens
SECRET_KEY=change_this_to_a_long_random_secret_string

# Gemini model name (kept configurable since model names change over time)
GEMINI_MODEL=gemini-1.5-flash

# JWT token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=120
